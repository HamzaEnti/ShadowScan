classDiagram
    class Main {
        +main(String[] args)$ void
    }

    class MainFrame {
        -DiscoveryPanel discoveryPanel
        -NmapPanel nmapPanel
        -SecurityPanel securityPanel
        -JTextArea txtConsole
        +afegirResultat(ResultatHost host) void
    }

    class BasePanel {
        <<abstracte>>
        #MainFrame parentFrame
        #initComponents()* void
        #crearBoto(String text) JButton
        #seleccionarFitxer(String titol) File
        #guardarFitxer(String titol, String nomPerDefecte) File
    }

    class DiscoveryPanel {
        -ScanController controller
        -List~ResultatHost~ resultats
        +afegirResultat(ResultatHost host) void
        -iniciarEscaneig() void
        -exportarResultats() void
    }

    class NmapPanel {
        -NmapWrapper nmapService
        -executarNmap() void
        +verificarInstalacio() void
    }

    class SecurityPanel {
        -BruteForceService bruteForceService
        -WebDiscoveryService webDiscoveryService
        -FuzzingService fuzzingService
        -File selectedWordlist
        -executarAtac() void
        +verificarInstalacions() void
    }

    class ConsoleRedirector {
        -JTextArea textArea
        +write(int b) void
    }

    class ScanController {
        -ExecutorService pool
        -boolean enExecucio
        -MainFrame vista
        +escanearRang(String xarxa, PortScanMode mode) void
        +aturar() void
    }

    class ScanTask {
        -String ip
        -MainFrame vista
        -PortScanMode mode
        +run() void
    }

    class PortScanMode {
        <<enumeracio>>
        PARCIAL
        FULL
        -int[] ports
        +esParcial() boolean
    }

    class AbstractResultat {
        <<abstracte>>
        #LocalDateTime dataEscaneig
        #EstatResultat estat
        +toDisplayString()* String
        +toJson()* String
    }

    class ResultatHost {
        -String ip
        -boolean esViu
        -List~Integer~ portsOberts
        +setEsViu(boolean esViu) void
        +afegirPort(int port) void
    }

    class EstatResultat {
        <<enumeracio>>
        PENDENT
        ONLINE
        OFFLINE
        ERROR
    }

    class Scannable {
        <<interficie>>
        +checkInstalled() boolean
        +executar(String target, int port) void
        +getNomEina() String
    }

    class AbstractScanService {
        <<abstracte>>
        #String nomEina
        #log(String missatge) void
        #fitxerExisteix(String ruta) boolean
        +checkInstalled()* boolean
        +executar(String target, int port)* void
    }

    class NmapWrapper {
        -List~String~ resultats
        +escanearConNmap(String ip) void
        +exportToCSV(File file) boolean
    }

    class BruteForceService {
        -String rutaUsuaris
        -String rutaPasswords
        +atacar(String ip, int port, String rutaUsers, String rutaPass) void
        -determinarProtocol(int port) String
    }

    class WebDiscoveryService {
        -List~String~ foundUrls
        -String customDictionaryPath
        +loadCustomDictionary(File dictionaryFile) void
        +discoverWebPaths(String baseUrl) void
    }

    class FuzzingService {
        -String wordlistPath
        +lanzarFuzzing(String ip, int port, String rutaWordlist) void
    }

    class NetworkUtil {
        +isReachable(String ip, int timeout)$ boolean
        +isPortOpen(String ip, int port, int timeout)$ boolean
    }

    class JsonExporter {
        +saveToJSON(List~ResultatHost~ resultats, String path)$ boolean
    }

    class FileUtils {
        +llegirLinies(File fitxer)$ List~String~
        +existeixILlegible(String path)$ boolean
    }

    Main ..> MainFrame 
    MainFrame *-- DiscoveryPanel 
    MainFrame *-- NmapPanel 
    MainFrame *-- SecurityPanel 
    MainFrame *-- ConsoleRedirector 
    MainFrame ..> ResultatHost 
    BasePanel <|-- DiscoveryPanel 
    BasePanel <|-- NmapPanel 
    BasePanel <|-- SecurityPanel 
    BasePanel --> MainFrame 
    DiscoveryPanel *-- ScanController 
    DiscoveryPanel --> ResultatHost 
    DiscoveryPanel ..> JsonExporter 
    DiscoveryPanel ..> PortScanMode 
    NmapPanel *-- NmapWrapper
    SecurityPanel *-- BruteForceService 
    SecurityPanel *-- WebDiscoveryService 
    SecurityPanel *-- FuzzingService 
    ScanController --> MainFrame 
    ScanController ..> ScanTask 
    ScanController --> PortScanMode 
    ScanTask --> MainFrame 
    ScanTask --> PortScanMode 
    ScanTask ..> ResultatHost 
    ScanTask ..> NetworkUtil 
    AbstractResultat <|-- ResultatHost 
    AbstractResultat --> EstatResultat 
    ResultatHost --> EstatResultat 
    Scannable <|.. AbstractScanService 
    AbstractScanService <|-- NmapWrapper 
    AbstractScanService <|-- BruteForceService 
    AbstractScanService <|-- WebDiscoveryService 
    AbstractScanService <|-- FuzzingService 
    JsonExporter ..> ResultatHost 
    BruteForceService ..> FileUtils 
    WebDiscoveryService ..> FileUtils 
    FuzzingService ..> FileUtils 